{$DOMAIN} {
	encode gzip

	# A Meta manda webhooks bem menores que isso; o app também limita.
	request_body {
		max_size 1MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}

	# Só o webhook e o health simples ficam públicos. /health/ready consulta o banco
	# e é usado apenas pelo healthcheck interno do Docker.
	@public path /webhook /health
	handle @public {
		reverse_proxy app:8000
	}
	handle {
		respond 404
	}
}
